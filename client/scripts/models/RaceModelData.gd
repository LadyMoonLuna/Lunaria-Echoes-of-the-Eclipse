	"27": {"id":27,"key":"nephilim","name":"Nephilim","title":"Híbrido do Crepúsculo","lore":"A maior heresia da história de Lunaria. Antes da queda dos céus, um Serafim do Trono Solar e uma Dama da Corte do Eclipse quebraram o juramento eterno e conceberam uma criança no exato instante do pôr do sol. O Nephilim carrega uma asa de luz dourada no ombro direito e uma asa de penas negras no ombro esquerdo, sendo caçado tanto pelos fanáticos da luz quanto pelos monstros da escuridão.","color":"#ffd700","scale":1.04,"materials":{"skin":{"color":"#e9d2bd","rough":0.5,"metal":0.0},"robe_white":{"color":"#f6f1e3","rough":0.7,"metal":0.0},"robe_black":{"color":"#16121c","rough":0.6,"metal":0.0},"gold":{"color":"#ffc107","rough":0.2,"metal":0.9,"emit":"#ffb300","energy":0.35},"hair":{"color":"#efe0b4","rough":0.5,"metal":0.0},"feather_light":{"color":"#fff8c4","rough":0.3,"metal":0.0,"emit":"#ffd54f","energy":3.2,"alpha":0.88,"double":true,"anim":{"type":"glow","speed":1.4,"min":0.75,"max":1.25}},"feather_dark":{"color":"#0e0b14","rough":0.35,"metal":0.3,"emit":"#4a148c","energy":0.35,"double":true},"eye_gold":{"color":"#fff59d","rough":0.6,"metal":0.0,"emit":"#ffd600","energy":6.0},"eye_violet":{"color":"#e1bee7","rough":0.6,"metal":0.0,"emit":"#aa00ff","energy":6.0},"halo_gold":{"color":"#fff59d","rough":0.6,"metal":0.0,"emit":"#ffd54f","energy":5.0},"halo_void":{"color":"#311b92","rough":0.6,"metal":0.0,"emit":"#6200ea","energy":2.5}},"groups":[{"name":"leg_l","pivot":[-0.1056,0.94,0]},{"name":"leg_r","pivot":[0.1056,0.94,0]},{"name":"arm_l","pivot":[-0.2496,1.47,0]},{"name":"arm_r","pivot":[0.2496,1.47,0]},{"name":"halo","pivot":[0,2.0,0.08],"anim":{"type":"bob","amp":0.015,"speed":1.4}},{"name":"wing_r","pivot":[0.1,1.45,0.16],"anim":{"type":"sway","axis":[0,1,0],"amp":7.0,"speed":1.3}},{"name":"wing_l","pivot":[-0.1,1.45,0.16],"anim":{"type":"sway","axis":[0,-1,0],"amp":7.0,"speed":1.3}}],"parts":[{"shape":"capsule","size":[0.0816,0.5],"pos":[-0.1056,0.7,0],"mat":"robe_whi